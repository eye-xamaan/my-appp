PORT=3000
NODE_ENV=development
ADMIN_USERNAME=admin
# Change this to a long, unique password before deployment.
ADMIN_PASSWORD=change-this-password-now
SESSION_SECRET=replace-with-a-long-random-secret
# Optional Telegram alerts:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Google Drive backups. Share the target Drive folder with the service-account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Optional public URLs:
WHATSAPP_URL=https://wa.me/
INSTAGRAM_URL=https://instagram.com/
